# React App Environment Variables
# REACT_APP_API_BASE_URL=http://localhost:3189 // Development URL
REACT_APP_API_BASE_URL=https://admin-studio-api.ipshopy.com // Production URL
REACT_APP_APP_NAME=Ipshopy Studio
REACT_APP_VERSION=1.0.0

# Development settings
NODE_ENV=development

# NOTE: Base URL is now managed through constants.js file
# To change the base URL, modify the BASE_URL constant in src/Config/constants.js
# Individual API endpoints below are still used where applicable

# API endpoints
REACT_APP_API_USERS=/Users
REACT_APP_API_CATEGORIES=/Categories
REACT_APP_API_DATASYNC=/DataSync
REACT_APP_API_EMPLOYEES=/Employees
REACT_APP_API_USER_GROUPS=/user-groups
REACT_APP_API_MASTERS=/Masters
REACT_APP_API_SELLER_APPROVAL=/SellerApproval
REACT_APP_API_SELLER_REGISTRATION=/SellerRegistration
REACT_APP_API_STUDIO=/Studio
REACT_APP_API_STUDIO_REELS=/api/studio/reels

# Application settings
REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_UPLOAD_MAX_SIZE=52428800
REACT_APP_SUPPORTED_VIDEO_FORMATS=mp4,mov,avi,wmv
REACT_APP_SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif

# Feature flags
REACT_APP_ENABLE_SELLER_REELS=true
REACT_APP_ENABLE_INFLUENCER_REELS=true
REACT_APP_ENABLE_BRAND_REELS=true