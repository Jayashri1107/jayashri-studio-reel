PORT=3189

# Azure upload configuration (required)
AZURE_UPLOAD_URL=https://your-function.azurewebsites.net/api/UploadReel?code=YOUR_FUNCTION_KEY
# If you prefer, set the base URL instead (we append /api/UploadReel)
# AZURE_UPLOAD_BASE_URL=https://your-function.azurewebsites.net
AZURE_FUNCTION_KEY=YOUR_FUNCTION_KEY

# Azure SAS token for reading blobs (choose ONE; include ?sv=...&sig=...)
# AZURE_BLOB_SAS_QUERY=?sv=...&sig=...
# AZURE_BLOB_SAS_TOKEN=?sv=...&sig=...
# AZURE_STORAGE_SAS=?sv=...&sig=...
# AZURE_SAS_TOKEN=?sv=...&sig=...

# Set true if blobs are public and you do NOT want SAS appended to URLs
# AZURE_SAS_DISABLED=false

